# Production Compose settings. Copy to an untracked .env and replace the
# placeholders before starting the stack. Never commit credentials.

# Image published by the maintained Send fork.
DOCKER_SEND_IMAGE=registry.gitlab.com/timvisee/send:latest

# Public DNS name and URL served by the reverse proxy.
HOST=send.example.org
BASE_URL=https://send.example.org
LETSENCRYPT_HOST=send.example.org
LETSENCRYPT_EMAIL=mail@example.org

# Choose one storage backend. Leave S3_BUCKET and GCS_BUCKET empty to use the
# persistent host directory mounted at /var/lib/send/uploads.
FILE_DIR=/uploads
S3_BUCKET=
AWS_REGION=
S3_ENDPOINT=
S3_USE_PATH_STYLE_ENDPOINT=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Redis is provided by this Compose stack. Keep the password empty unless the
# Redis service is separately hardened and configured with authentication.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=
REDIS_EVENT_EXPIRE=false
REDIS_RETRY_TIME=10000
REDIS_RETRY_DELAY=500

# Upload, download, and abuse-control limits.
EXPIRE_TIMES_SECONDS=300,3600,86400,604800
DEFAULT_EXPIRE_SECONDS=86400
MAX_EXPIRE_SECONDS=604800
DOWNLOAD_COUNTS=1,2,3,4,5,20,50,100
DEFAULT_DOWNLOADS=1
MAX_DOWNLOADS=100
MAX_FILES_PER_ARCHIVE=64
MAX_ARCHIVES_PER_USER=16
MAX_CONTROL_MESSAGE_SIZE=1048576
MAX_METADATA_SIZE=262144
MAX_FILE_SIZE=2684354560
REQUEST_RATE_LIMIT=1200
REQUEST_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=100
UPLOAD_RATE_WINDOW_SECONDS=3600
MAX_CONCURRENT_UPLOADS=4
UPLOAD_LEASE_SECONDS=60

# Trust only the proxy network if client IP/rate limiting should use forwarded
# headers. Do not use a broad or unverified value in production.
TRUST_PROXY=false
IP_ADDRESS=0.0.0.0
PORT=1443
NODE_ENV=production

# Optional observability, authentication, branding, and notices.
SENTRY_CLIENT=
SENTRY_DSN=
FXA_URL=https://send-fxa.dev.lcip.org
FXA_CLIENT_ID=
FXA_KEY_SCOPE=https://identity.mozilla.com/apps/send
FXA_CSP_OAUTH_URL=
FXA_CSP_CONTENT_URL=
FXA_CSP_PROFILE_URL=
FXA_CSP_PROFILEIMAGE_URL=
SURVEY_URL=
IP_DB=
CUSTOM_TITLE=Send
CUSTOM_DESCRIPTION=Encrypt and send files with a link that automatically expires to ensure your important documents don’t stay online forever.
L10N_DEV=false
CUSTOM_LOCALE=
DETECT_BASE_URL=false
SEND_FOOTER_DONATE_URL=
SEND_FOOTER_CLI_URL=https://github.com/timvisee/ffsend
SEND_FOOTER_DMCA_URL=
SEND_FOOTER_SOURCE_URL=https://github.com/timvisee/send
CUSTOM_FOOTER_TEXT=
CUSTOM_FOOTER_URL=
SEND_MAIN_NOTICE_HTML=
SEND_UPLOAD_AREA_NOTICE_HTML=
SEND_UPLOADS_LIST_NOTICE_HTML=
SEND_DOWNLOAD_NOTICE_HTML=
SHOW_THUNDERBIRD_SPONSOR=false
UI_COLOR_PRIMARY=#0a84ff
UI_COLOR_ACCENT=#003eaa
UI_CUSTOM_ASSETS_ANDROID_CHROME_192PX=
UI_CUSTOM_ASSETS_ANDROID_CHROME_512PX=
UI_CUSTOM_ASSETS_APPLE_TOUCH_ICON=
UI_CUSTOM_ASSETS_FAVICON_16PX=
UI_CUSTOM_ASSETS_FAVICON_32PX=
UI_CUSTOM_ASSETS_ICON=
UI_CUSTOM_ASSETS_SAFARI_PINNED_TAB=
UI_CUSTOM_ASSETS_FACEBOOK=
UI_CUSTOM_ASSETS_TWITTER=
UI_CUSTOM_ASSETS_WORDMARK=
UI_CUSTOM_CSS=
